{
  "name": "pawan-os-portfolio",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "resume:pdf": "node --experimental-strip-types scripts/export-resume.mjs | python3 scripts/build-resume.py",
    "check:pdf": "node --experimental-strip-types scripts/export-resume.mjs | python3 scripts/check-resume.py",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.536.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
